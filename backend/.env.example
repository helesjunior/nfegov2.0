APP_NAME="NFeGov 2.0"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Banco de dados (PostgreSQL) ---------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nfegov
DB_USERNAME=nfegov
DB_PASSWORD=nfegov

# --- Sessão / fila / cache ---------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# --- Redis (cache, fila e rate limiter global da SEFAZ) ----------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-mail (alertas de certificado e exportações) ---------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@nfegov.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Horizon -----------------------------------------------------------------
HORIZON_NAME=nfegov

# --- NFeGov: sincronização com a SEFAZ ---------------------------------------
# Intervalo do agendamento da NF-e, em horas (1 a 23). De hora em hora é seguro:
# cada unidade respeita a espera de 1 h da SEFAZ depois de ver a fila vazia.
NFEGOV_SYNC_INTERVAL_HOURS=1
# Pausa (segundos) entre consultas distDFe dentro de uma execução.
NFEGOV_SYNC_SLEEP_SECONDS=2
# Sincronizar só de segunda a sexta. A SEFAZ distribui NF-e todos os dias.
NFEGOV_SYNC_WEEKDAYS_ONLY=false

# --- NFeGov: freio global anti-bloqueio (multitenant, por IP) ----------------
# Teto de consultas distDFe por minuto no servidor inteiro.
NFEGOV_SEFAZ_RATE_PER_MINUTE=30
# Ao receber cStat 656, a fila de sync pausa por estes minutos.
NFEGOV_SEFAZ_CIRCUIT_BREAKER_MINUTES=60
# Janela (minutos) em que as unidades são escalonadas para não criar picos.
NFEGOV_SEFAZ_SLOT_WINDOW_MINUTES=180
# Máximo de consultas por execução de sync.
NFEGOV_SEFAZ_MAX_ITERACOES=150
# Máximo de documentos processados por execução.
NFEGOV_SEFAZ_MAX_DOCS=100
# Pausa (segundos) entre consultas (freio por execução).
NFEGOV_SEFAZ_SLEEP=2
# Espera (minutos) depois de ver a fila vazia. A SEFAZ exige 1 hora; menos que
# 60 leva ao cStat 656.
NFEGOV_SEFAZ_ESPERA_FILA_VAZIA_MINUTES=61
# Quando a execução para no teto com a fila ainda cheia, a próxima parte
# começa depois destes segundos.
NFEGOV_SEFAZ_CONTINUACAO_SECONDS=60

# --- NFeGov: NFS-e (Ambiente de Dados Nacional) ------------------------------
# Liga/desliga a recepção de NFS-e (e o bloco de NFS-e do painel).
NFEGOV_ADN_HABILITADO=true
# API de contribuintes do ADN e SEFIN Nacional (manifestação), por ambiente da
# unidade (`tp_amb`: 1 produção, 2 produção restrita). Os padrões já apontam
# para os endereços oficiais; só mude para apontar para outro ambiente.
#NFEGOV_ADN_URL_PRODUCAO=https://adn.nfse.gov.br/contribuintes
#NFEGOV_ADN_URL_HOMOLOGACAO=https://adn.producaorestrita.nfse.gov.br/contribuintes
#NFEGOV_SEFIN_URL_PRODUCAO=https://sefin.nfse.gov.br/SefinNacional
#NFEGOV_SEFIN_URL_HOMOLOGACAO=https://sefin.producaorestrita.nfse.gov.br/SefinNacional
# Fila do Horizon e número de processos (um basta: a carga histórica se divide
# em várias execuções).
NFEGOV_ADN_QUEUE=adn
NFEGOV_ADN_WORKERS=1
# Timeout (segundos) das chamadas ao ADN e à SEFIN.
NFEGOV_ADN_TIMEOUT=30
# Freio do ADN: teto global de consultas por minuto e pausa do circuit breaker
# (minutos) ao receber HTTP 429/502/503/504.
NFEGOV_ADN_RATE_PER_MINUTE=30
NFEGOV_ADN_CIRCUIT_BREAKER_MINUTES=30
# Janela (minutos) em que as unidades são escalonadas.
NFEGOV_ADN_SLOT_WINDOW_MINUTES=180
# Por execução de uma unidade: máximo de consultas, de documentos e pausa (s).
NFEGOV_ADN_MAX_ITERACOES=20
NFEGOV_ADN_MAX_DOCS=1000
NFEGOV_ADN_SLEEP=1

# --- NFeGov: retentativa automática da recuperação manual de NF-e ------------
# Intervalos (minutos) entre as tentativas automáticas da recuperação manual
# de NF-e. Um valor por tentativa, separados por vírgula. Só se aplicam após
# falhas retentáveis (`nao_encontrado`/`erro`); o freio de consumo (`bloqueado`)
# espera fechar sem consumir tentativa.
NFEGOV_RECUPERACAO_BACKOFF_MINUTES=30,120,360

# --- NFeGov: certificado digital e-CNPJ --------------------------------------
# Marcos (dias) dos alertas de vencimento, enviados por e-mail.
NFEGOV_CERT_ALERT_DAYS=60,30,15,7,1
# Validade (minutos) da janela de MFA recente para rotação do certificado.
NFEGOV_CERT_STEP_UP_MINUTES=15
# Tamanho máximo do arquivo PFX/P12 (KB).
NFEGOV_CERT_MAX_KB=5120

# --- NFeGov: armazenamento ---------------------------------------------------
# Disco (config/filesystems.php) e raiz onde os XMLs fiscais são gravados.
NFEGOV_XML_DISK=local
NFEGOV_XML_ROOT=tenants
# Disco e raiz onde os PFX (cifrados) dos certificados ficam.
NFEGOV_CERT_DISK=local
NFEGOV_CERT_ROOT=certificados

# --- NFeGov: MFA -------------------------------------------------------------
# Papéis obrigados a configurar o segundo fator estão em config/nfegov.php.
NFEGOV_MFA_STEP_UP_MINUTOS=15

VITE_APP_NAME="${APP_NAME}"