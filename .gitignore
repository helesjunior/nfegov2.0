# --- Backend (Laravel) ---
/backend/vendor/
/backend/node_modules/
/backend/public/build/
/backend/public/hot
/backend/public/storage/
/backend/storage/*.key
/backend/storage/framework/cache/data/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/storage/logs/*
/backend/.env
/backend/.env.backup
/backend/.phpunit.result.cache
/backend/.phpunit.cache/

# --- Frontend (React/Vite) ---
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/

# --- Certificados e dados sensíveis ---
# Nunca versionar PFX nem XMLs fiscais de produção
/backend/storage/app/certificados/
/backend/storage/app/tenants/
*.pfx
*.p12

# --- Docker / SO ---
.env
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp